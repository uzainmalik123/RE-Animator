# The repo's ONE env file. Copy it to .env here at the repo root (gitignored) and fill in what you have.
# NEVER put a real value in .env.example: CI's secrets guard blocks the PR, and a pushed key must be rotated.
#
# The game itself needs no keys yet. These are for the LLM jobs in the plan (docs/GAME_PLAN.md):
# Kiro's hints, Death's taunts and the post-incident report. Which provider we use is still open.

# ── Free (testing) ────────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=
# Ollama: no key, but `ollama serve` must be running.
OLLAMA_MODEL=

# ── Paid (the demo) ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
