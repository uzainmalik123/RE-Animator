# The repo's ONE env file. Copy it to .env right here at the repo root (gitignored), fill in every key
# you have, then from reanimator/ swap setups with one command; each checks .env first and says what's missing:
#
#   npm run server:free             free LLM + the fake Kiro: spends nothing     (add -- ollama)
#   npm run server:paid             Claude on Bedrock + the real Kiro: the demo  (add -- claude for the Anthropic API)
#   npm run e2b:free / e2b:paid     the same, hosted live on E2B                 (add -- --minutes 30)
#
# Anything already set in your shell or by Doppler wins over this file. NEVER put a real value in
# .env.example: CI's secrets guard blocks the PR, and a pushed key must be rotated.

# ── Which provider each profile uses (defaults shown) ─────────────────────────────────────
REANIMATOR_FREE_LLM=groq
REANIMATOR_PAID_LLM=bedrock

# ── Free providers (testing) ──────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=
# Ollama: no key, but `ollama serve` must be running, and it works only locally (not on E2B).
OLLAMA_MODEL=

# ── Paid providers (the demo and submission) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional for both Claude routes; empty = Poltergeist's default Claude model.
CLAUDE_MODEL=

# Bedrock: a region plus any one credential source (a Bedrock API key, AWS keys, or AWS_PROFILE).
AWS_REGION=
AWS_BEARER_TOKEN_BEDROCK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=

# ── Live host on E2B ──────────────────────────────────────────────────────────────────────
# Stays on this machine. Only the LLM settings above are sent into the sandbox.
E2B_API_KEY=

# ── Poltergeist on its own (`npm run summon` in poltergeist/) ─────────────────────────────
# Reanimator passes Poltergeist only its LLM keys; the engine never reads this file itself. To run it
# alone, load it first: `cd poltergeist && set -a && . ../.env && set +a && npm run summon` (or Doppler).
# Candy Swap's seeded ghost1…ghost6 password (fixtures/candy-swap/poltergeist.config.json, env:CANDY_SWAP_PASSWORD).
CANDY_SWAP_PASSWORD=

# ── Optional ──────────────────────────────────────────────────────────────────────────────
# Record the session for the hosted replay (R11). Only a real run goes in public/recording/.
# REANIMATOR_RECORD=public/recording
# Backend port (default 7070; the Vite dev server proxies /api to it).
# REANIMATOR_PORT=7070
# Manual mode, for plain `npm run server` only (the profiles above override these):
# REANIMATOR_LLM=
# REANIMATOR_LLM_MODEL=
# REANIMATOR_KIRO=
