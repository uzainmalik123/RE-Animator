{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "poltergeist": {
      "type": "stdio",
      "command": "node",
      "args": ["/ABSOLUTE/PATH/TO/poltergeist/packages/mcp/bin/poltergeist-mcp.js", "--root-from-spec"],
      "env": {
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}"
      }
    }
  }
}
