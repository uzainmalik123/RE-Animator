# Copy to .env, or (preferred) keep these in Doppler: `doppler run -- npm run summon`.
# Never commit real keys.

# Anthropic API key for the ghost compiler (F05).
ANTHROPIC_API_KEY=

# Only with "provider": "bedrock" in poltergeist.config.json (F19). Any one AWS credential source works:
# a Bedrock API key, AWS keys, or AWS_PROFILE. The region can also be "awsRegion" in the config.
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_REGION=us-east-1

# Only with "provider": "gemini" or "groq" in poltergeist.config.json (D-50), plus that provider's own
# "model". Free tiers, for testing; the real runs use Claude. "ollama" needs no key (local ollama serve).
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Demo password for Candy Swap's seeded ghost1…ghost6 users: whatever Kiro's seed uses
# (see fixtures/candy-swap/.env.example once Candy Swap is built). Read by
# fixtures/candy-swap/poltergeist.config.json as env:CANDY_SWAP_PASSWORD.
CANDY_SWAP_PASSWORD=
