# Reanimator's secrets and switches. Copy to reanimator/.env (gitignored) and fill in what you use.
# `npm run server`, `npm run attack:check` and `npm run e2b:up` read it; anything already set in your
# shell or by Doppler (`doppler run -- npm run server`) wins over this file. Never commit real keys.

# ── Death's LLM (Poltergeist's ghost compiler) ─────────────────────────────────────────────
# Pick ONE provider. Unset = anthropic (Claude). Plans are cached per provider + model, so
# switching providers plans each fixture once more.
#   anthropic  Claude via the Anthropic API              needs ANTHROPIC_API_KEY
#   bedrock    Claude via Amazon Bedrock (submission)    needs AWS credentials + AWS_REGION
#   gemini     free tier, for testing                    needs GEMINI_API_KEY + REANIMATOR_LLM_MODEL
#   groq       free tier, for testing                    needs GROQ_API_KEY + REANIMATOR_LLM_MODEL
#   ollama     local and free (not on E2B)               needs a running `ollama serve` + REANIMATOR_LLM_MODEL
REANIMATOR_LLM=
# Required for gemini / groq / ollama (a model id from that provider). Optional for Claude.
REANIMATOR_LLM_MODEL=

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Bedrock: any one AWS credential source works (a Bedrock API key, AWS keys, or AWS_PROFILE).
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=
# AWS_REGION=us-east-1

# ── The grimoire (Kiro) ───────────────────────────────────────────────────────────────────
# Unset = the real `kiro-cli` on your PATH (installed and logged in; spends Kiro credit).
# To test without spending Kiro tokens, point it at the fake (use your absolute path):
# REANIMATOR_KIRO=/path/to/reanimator/server/fixtures/fake-kiro.mjs

# ── Live host on E2B (`npm run e2b:up`) ───────────────────────────────────────────────────
# Stays on this machine. e2b:up forwards only the LLM settings above into the sandbox.
E2B_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────────────────
# Record the session for the hosted replay (R11). Only a real run goes in public/recording/.
# REANIMATOR_RECORD=public/recording
# Backend port (default 7070; the Vite dev server proxies /api to it).
# REANIMATOR_PORT=7070
